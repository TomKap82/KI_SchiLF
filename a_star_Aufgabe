<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>A*-Algorithmus Interaktive Lerneinheit</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- MathJax for formula rendering -->
    <script src="https://polyfill.io/v3/polyfill.min.js?features=es6"></script>
    <script id="MathJax-script" async src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');
        body {
            font-family: 'Inter', sans-serif;
            background-color: #0f172a;
            color: #f8fafc;
        }
        .node-circle {
            transition: all 0.3s ease;
            cursor: pointer;
        }
        .node-circle:hover {
            filter: drop-shadow(0 0 12px rgba(59, 130, 246, 0.8));
        }
        .node-active {
            fill: #3b82f6 !important;
            stroke: #60a5fa !important;
            stroke-width: 4px;
        }
        .node-expanded {
            fill: #10b981 !important;
            stroke: #34d399 !important;
        }
        .node-target {
            fill: #f59e0b !important;
            stroke: #fbbf24 !important;
        }
        .edge-line {
            transition: stroke 0.3s ease, stroke-width 0.3s ease;
        }
        .edge-active {
            stroke: #3b82f6 !important;
            stroke-width: 4px !important;
        }
        .edge-path {
            stroke: #10b981 !important;
            stroke-width: 5px !important;
        }
        .glass-panel {
            background: rgba(30, 41, 59, 0.7);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }
    </style>
</head>
<body class="min-h-screen flex flex-col justify-between p-4 md:p-8">

    <!-- Header -->
    <header class="max-w-6xl mx-auto w-full mb-6 text-center md:text-left flex flex-col md:flex-row justify-between items-center border-b border-slate-700 pb-4">
        <div>
            <h1 class="text-3xl font-bold text-blue-400 flex items-center gap-3">
                <i class="fa-solid fa-route text-amber-400"></i> A*-Algorithmus Lerneinheit
            </h1>
            <p class="text-slate-400 text-sm mt-1">Berechnung der Pfadkosten $f(n) = g(n) + h(n)$ und Bestimmung des kürzesten Weges</p>
        </div>
        <div class="mt-4 md:mt-0 flex gap-2">
            <button id="btn-reset" onclick="resetTask()" class="px-4 py-2 bg-slate-700 hover:bg-slate-600 text-white rounded-lg text-sm font-medium transition flex items-center gap-2">
                <i class="fa-solid fa-rotate-left"></i> Neustart
            </button>
            <button id="btn-help" onclick="toggleHelpModal()" class="px-4 py-2 bg-blue-600 hover:bg-blue-500 text-white rounded-lg text-sm font-medium transition flex items-center gap-2">
                <i class="fa-solid fa-circle-question"></i> Formel & Hilfe
            </button>
        </div>
    </header>

    <!-- Main Content Container -->
    <main class="max-w-6xl mx-auto w-full grid grid-cols-1 lg:grid-cols-12 gap-6 flex-grow">

        <!-- Left Column: Graph Visualization (SVG) -->
        <div class="lg:col-span-7 flex flex-col">
            <div class="glass-panel rounded-2xl p-4 flex-grow flex flex-col justify-between shadow-xl">
                <div class="flex justify-between items-center mb-2 px-2">
                    <span class="text-xs font-semibold uppercase tracking-wider text-slate-400">Graphen-Netzwerk</span>
                    <div class="flex gap-4 text-xs">
                        <span class="flex items-center gap-1"><span class="w-3 h-3 rounded-full bg-blue-500 inline-block"></span> Aktuell</span>
                        <span class="flex items-center gap-1"><span class="w-3 h-3 rounded-full bg-emerald-500 inline-block"></span> Expandiert</span>
                        <span class="flex items-center gap-1"><span class="w-3 h-3 rounded-full bg-amber-500 inline-block"></span> Ziel (Würzburg)</span>
                    </div>
                </div>

                <!-- SVG Container -->
                <div class="w-full relative overflow-hidden rounded-xl bg-black/40 border border-slate-800 p-2 flex items-center justify-center">
                    <svg viewBox="0 0 900 500" class="w-full h-auto max-h-[480px]" id="graph-svg">
                        <!-- Edges (Paths) -->
                        <g id="edges-layer">
                            <!-- Saarbrücken - Kaiserslautern -->
                            <line id="edge-SB-KL" x1="120" y1="410" x2="280" y2="260" stroke="#475569" stroke-width="2.5" class="edge-line" />
                            <rect x="185" y="325" width="32" height="20" rx="4" fill="#0f172a" stroke="#334155" />
                            <text x="201" y="339" fill="#94a3b8" font-size="12" font-weight="bold" text-anchor="middle">70</text>

                            <!-- Kaiserslautern - Frankfurt -->
                            <line id="edge-KL-FFM" x1="280" y1="260" x2="490" y2="100" stroke="#475569" stroke-width="2.5" class="edge-line" />
                            <rect x="372" y="170" width="36" height="20" rx="4" fill="#0f172a" stroke="#334155" />
                            <text x="390" y="184" fill="#94a3b8" font-size="12" font-weight="bold" text-anchor="middle">103</text>

                            <!-- Kaiserslautern - Ludwigshafen -->
                            <line id="edge-KL-LU" x1="280" y1="260" x2="530" y2="220" stroke="#475569" stroke-width="2.5" class="edge-line" />
                            <rect x="395" y="230" width="32" height="20" rx="4" fill="#0f172a" stroke="#334155" />
                            <text x="411" y="244" fill="#94a3b8" font-size="12" font-weight="bold" text-anchor="middle">53</text>

                            <!-- Ludwigshafen - Würzburg -->
                            <line id="edge-LU-WUE" x1="530" y1="220" x2="800" y2="160" stroke="#475569" stroke-width="2.5" class="edge-line" />
                            <rect x="650" y="180" width="36" height="20" rx="4" fill="#0f172a" stroke="#334155" />
                            <text x="668" y="194" fill="#94a3b8" font-size="12" font-weight="bold" text-anchor="middle">120</text>

                            <!-- Ludwigshafen - Karlsruhe -->
                            <line id="edge-LU-KA" x1="530" y1="220" x2="510" y2="390" stroke="#475569" stroke-width="2.5" stroke-dasharray="4" class="edge-line" />
                            <rect x="510" y="295" width="32" height="20" rx="4" fill="#0f172a" stroke="#334155" />
                            <text x="526" y="309" fill="#94a3b8" font-size="12" font-weight="bold" text-anchor="middle">68</text>

                            <!-- Karlsruhe - Heilbronn -->
                            <line id="edge-KA-HN" x1="510" y1="390" x2="740" y2="360" stroke="#475569" stroke-width="2.5" class="edge-line" />
                            <rect x="615" y="365" width="32" height="20" rx="4" fill="#0f172a" stroke="#334155" />
                            <text x="631" y="379" fill="#94a3b8" font-size="12" font-weight="bold" text-anchor="middle">84</text>

                            <!-- Heilbronn - Würzburg -->
                            <line id="edge-HN-WUE" x1="740" y1="360" x2="800" y2="160" stroke="#475569" stroke-width="2.5" class="edge-line" />
                            <rect x="760" y="250" width="36" height="20" rx="4" fill="#0f172a" stroke="#334155" />
                            <text x="778" y="264" fill="#94a3b8" font-size="12" font-weight="bold" text-anchor="middle">102</text>
                        </g>

                        <!-- Nodes (Cities) -->
                        <g id="nodes-layer">
                            <!-- Saarbrücken -->
                            <g id="node-SB" transform="translate(120, 410)">
                                <ellipse rx="75" ry="35" fill="#1e293b" stroke="#64748b" stroke-width="2" class="node-circle" />
                                <text y="-5" fill="#ffffff" font-size="14" font-weight="bold" text-anchor="middle">Saarbrücken</text>
                                <text y="15" fill="#cbd5e1" font-size="13" text-anchor="middle">h = 222</text>
                            </g>

                            <!-- Kaiserslautern -->
                            <g id="node-KL" transform="translate(280, 260)">
                                <ellipse rx="80" ry="35" fill="#1e293b" stroke="#64748b" stroke-width="2" class="node-circle" />
                                <text y="-5" fill="#ffffff" font-size="14" font-weight="bold" text-anchor="middle">Kaiserslautern</text>
                                <text y="15" fill="#cbd5e1" font-size="13" text-anchor="middle">h = 158</text>
                            </g>

                            <!-- Frankfurt -->
                            <g id="node-FFM" transform="translate(490, 100)">
                                <ellipse rx="75" ry="35" fill="#1e293b" stroke="#64748b" stroke-width="2" class="node-circle" />
                                <text y="-5" fill="#ffffff" font-size="14" font-weight="bold" text-anchor="middle">Frankfurt</text>
                                <text y="15" fill="#cbd5e1" font-size="13" text-anchor="middle">h = 96</text>
                            </g>

                            <!-- Ludwigshafen -->
                            <g id="node-LU" transform="translate(530, 220)">
                                <ellipse rx="80" ry="35" fill="#1e293b" stroke="#64748b" stroke-width="2" class="node-circle" />
                                <text y="-5" fill="#ffffff" font-size="14" font-weight="bold" text-anchor="middle">Ludwigshafen</text>
                                <text y="15" fill="#cbd5e1" font-size="13" text-anchor="middle">h = 108</text>
                            </g>

                            <!-- Karlsruhe -->
                            <g id="node-KA" transform="translate(510, 390)">
                                <ellipse rx="75" ry="35" fill="#1e293b" stroke="#64748b" stroke-width="2" class="node-circle" />
                                <text y="-5" fill="#ffffff" font-size="14" font-weight="bold" text-anchor="middle">Karlsruhe</text>
                                <text y="15" fill="#cbd5e1" font-size="13" text-anchor="middle">h = 140</text>
                            </g>

                            <!-- Heilbronn -->
                            <g id="node-HN" transform="translate(740, 360)">
                                <ellipse rx="75" ry="35" fill="#1e293b" stroke="#64748b" stroke-width="2" class="node-circle" />
                                <text y="-5" fill="#ffffff" font-size="14" font-weight="bold" text-anchor="middle">Heilbronn</text>
                                <text y="15" fill="#cbd5e1" font-size="13" text-anchor="middle">h = 87</text>
                            </g>

                            <!-- Würzburg (Ziel) -->
                            <g id="node-WUE" transform="translate(800, 160)">
                                <ellipse rx="75" ry="35" fill="#1e293b" stroke="#f59e0b" stroke-width="3" class="node-circle node-target" />
                                <text y="-5" fill="#ffffff" font-size="15" font-weight="extrabold" text-anchor="middle">Würzburg</text>
                                <text y="15" fill="#fef08a" font-size="13" font-weight="bold" text-anchor="middle">h = 0 (Ziel)</text>
                            </g>
                        </g>
                    </svg>
                </div>

                <!-- Legend / Info Footer -->
                <div class="mt-3 flex justify-between items-center text-xs text-slate-400 bg-slate-800/50 p-2.5 rounded-lg border border-slate-700/50">
                    <div><span class="text-blue-400 font-semibold">g(n):</span> Tatsächliche Pfadkosten vom Start</div>
                    <div><span class="text-amber-400 font-semibold">h(n):</span> Heuristik (Luftlinie zum Ziel)</div>
                    <div><span class="text-emerald-400 font-semibold">f(n) = g(n) + h(n):</span> Gesamtkosten-Schätzung</div>
                </div>
            </div>
        </div>

        <!-- Right Column: Interactive Step-by-Step Task Panel -->
        <div class="lg:col-span-5 flex flex-col">
            <div class="glass-panel rounded-2xl p-5 flex-grow flex flex-col justify-between shadow-xl">
                
                <!-- Progress & Task Header -->
                <div>
                    <div class="flex justify-between items-center mb-4">
                        <span id="step-badge" class="px-3 py-1 bg-blue-500/20 text-blue-300 border border-blue-500/30 rounded-full text-xs font-semibold">
                            Schritt 1 von 3
                        </span>
                        <div class="flex text-amber-400 text-sm gap-1">
                            <i class="fa-solid fa-star"></i>
                            <i class="fa-solid fa-star"></i>
                            <i class="fa-solid fa-star"></i>
                        </div>
                    </div>

                    <h2 id="task-title" class="text-xl font-bold text-white mb-2">Expansion von Saarbrücken</h2>
                    <p id="task-description" class="text-slate-300 text-sm mb-4 leading-relaxed">
                        Wir starten in **Saarbrücken** ($g=0, h=222, f=222$). Berechne die Werte für alle erreichbaren Nachbarknoten.
                    </p>

                    <!-- Dynamic Input Table -->
                    <div id="interactive-area" class="space-y-4 my-4">
                        <!-- Content inserted dynamically by JS -->
                    </div>
                </div>

                <!-- Feedback & Action Buttons -->
                <div class="mt-6 pt-4 border-t border-slate-700/60">
                    <div id="feedback-message" class="hidden mb-4 p-3 rounded-lg text-sm font-medium"></div>
                    
                    <div class="flex gap-3">
                        <button id="btn-check" onclick="checkStep()" class="flex-1 py-3 bg-emerald-600 hover:bg-emerald-500 text-white rounded-xl font-semibold shadow-lg shadow-emerald-900/40 transition flex justify-center items-center gap-2">
                            <i class="fa-solid fa-check-circle"></i> Eingabe prüfen
                        </button>
                        <button id="btn-next" onclick="nextStep()" class="hidden flex-1 py-3 bg-blue-600 hover:bg-blue-500 text-white rounded-xl font-semibold shadow-lg shadow-blue-900/40 transition flex justify-center items-center gap-2">
                            Weiter <i class="fa-solid fa-arrow-right"></i>
                        </button>
                    </div>
                </div>

            </div>
        </div>

    </main>

    <!-- Modal: Help / Formula -->
    <div id="help-modal" class="fixed inset-0 bg-black/80 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
        <div class="glass-panel bg-slate-900 border border-slate-700 rounded-2xl max-w-lg w-full p-6 shadow-2xl relative">
            <button onclick="toggleHelpModal()" class="absolute top-4 right-4 text-slate-400 hover:text-white">
                <i class="fa-solid fa-xmark text-xl"></i>
            </button>
            <h3 class="text-xl font-bold text-blue-400 mb-3 flex items-center gap-2">
                <i class="fa-solid fa-graduation-cap"></i> Wie funktioniert der A*-Algorithmus?
            </h3>
            <div class="text-slate-300 text-sm space-y-3 leading-relaxed">
                <p>Der **A*-Algorithmus** ist ein informierter Suchalgorithmus zur Bestimmung des kürzesten Pfades in einem Graphen.</p>
                <div class="bg-slate-800 p-3 rounded-lg border border-slate-700 font-mono text-center text-blue-300 text-base">
                    f(n) = g(n) + h(n)
                </div>
                <ul class="list-disc pl-5 space-y-1 text-xs">
                    <li><strong class="text-emerald-400">g(n):</strong> Tatsächliche bisherige Reisetrecke vom Startknoten zum Knoten $n$.</li>
                    <li><strong class="text-amber-400">h(n):</strong> Geschätzte verbleibende Strecke von $n$ zum Ziel (Heuristik / Luftlinie).</li>
                    <li><strong class="text-blue-400">f(n):</strong> Geschätzte Gesamtkosten des Pfades über $n$.</li>
                </ul>
                <p class="text-xs text-slate-400">
                    <strong>Regel für den nächsten Schritt:</strong> Wähle immer den Unbesuchten Knoten aus der Open List mit dem <em>kleinsten f-Wert</em> zur nächsten Expansion aus!
                </p>
            </div>
            <button onclick="toggleHelpModal()" class="mt-5 w-full py-2.5 bg-slate-800 hover:bg-slate-700 text-white rounded-lg font-medium transition">
                Verstanden
            </button>
        </div>
    </div>

    <!-- Footer -->
    <footer class="max-w-6xl mx-auto w-full text-center text-slate-500 text-xs mt-6">
        Interaktive Lerneinheit A*-Algorithmus &bull; Informatik & Graphentheorie
    </footer>

    <!-- JavaScript Logic -->
    <script>
        // Graph Data Representation
        const graph = {
            nodes: {
                SB: { name: "Saarbrücken", h: 222 },
                KL: { name: "Kaiserslautern", h: 158 },
                FFM: { name: "Frankfurt", h: 96 },
                LU: { name: "Ludwigshafen", h: 108 },
                KA: { name: "Karlsruhe", h: 140 },
                HN: { name: "Heilbronn", h: 87 },
                WUE: { name: "Würzburg", h: 0 }
            },
            edges: [
                { from: "SB", to: "KL", cost: 70 },
                { from: "KL", to: "FFM", cost: 103 },
                { from: "KL", to: "LU", cost: 53 },
                { from: "LU", to: "WUE", cost: 120 },
                { from: "LU", to: "KA", cost: 68 },
                { from: "KA", to: "HN", cost: 84 },
                { from: "HN", to: "WUE", cost: 102 }
            ]
        };

        let currentStep = 1;

        // Step configurations
        const steps = [
            {
                stepNum: 1,
                title: "Schritt 1: Expansion von Saarbrücken",
                description: "Start ist **Saarbrücken** ($g=0$). Von hier aus erreichen wir nur **Kaiserslautern**. Berechne die Werte für Kaiserslautern.",
                activeNodes: ["SB"],
                activeEdges: ["edge-SB-KL"],
                targets: [
                    { id: "KL", name: "Kaiserslautern", correctG: 70, correctH: 158, correctF: 228 }
                ],
                expansionOptions: [
                    { id: "KL", label: "Kaiserslautern (f = 228)", correct: true }
                ]
            },
            {
                stepNum: 2,
                title: "Schritt 2: Expansion von Kaiserslautern",
                description: "Wir befinden uns nun in **Kaiserslautern** ($g=70$). Berechne die $f(n)$-Werte für die Nachbarn **Frankfurt** und **Ludwigshafen** und entscheide, welcher Knoten als Nächstes expandiert wird.",
                activeNodes: ["SB", "KL"],
                activeEdges: ["edge-SB-KL", "edge-KL-FFM", "edge-KL-LU"],
                targets: [
                    { id: "FFM", name: "Frankfurt", correctG: 173, correctH: 96, correctF: 269 },
                    { id: "LU", name: "Ludwigshafen", correctG: 123, correctH: 108, correctF: 231 }
                ],
                expansionOptions: [
                    { id: "LU", label: "Ludwigshafen (f = 231)", correct: true },
                    { id: "FFM", label: "Frankfurt (f = 269)", correct: false }
                ]
            },
            {
                stepNum: 3,
                title: "Schritt 3: Expansion von Ludwigshafen & Ziel",
                description: "Wir expandieren **Ludwigshafen** ($g=123$). Berechne den Pfad zum Ziel **Würzburg** über Ludwigshafen.",
                activeNodes: ["SB", "KL", "LU"],
                activeEdges: ["edge-SB-KL", "edge-KL-LU", "edge-LU-WUE"],
                targets: [
                    { id: "WUE", name: "Würzburg", correctG: 243, correctH: 0, correctF: 243 }
                ],
                expansionOptions: [
                    { id: "WUE", label: "Würzburg (Ziel erreicht, f = 243)", correct: true },
                    { id: "FFM", label: "Frankfurt (f = 269)", correct: false }
                ]
            }
        ];

        // Initialize App
        window.onload = function() {
            renderStep();
        };

        function renderStep() {
            const step = steps[currentStep - 1];

            // Update Header & Badge
            document.getElementById("step-badge").innerText = `Schritt ${step.stepNum} von 3`;
            document.getElementById("task-title").innerText = step.title;
            document.getElementById("task-description").innerHTML = step.description;

            // Reset Feedback & Buttons
            const feedbackEl = document.getElementById("feedback-message");
            feedbackEl.classList.add("hidden");
            document.getElementById("btn-check").classList.remove("hidden");
            document.getElementById("btn-next").classList.add("hidden");

            // Update SVG Graphics
            updateSvgHighlights(step);

            // Render Input Forms
            const container = document.getElementById("interactive-area");
            container.innerHTML = "";

            // Inputs for calculations
            step.targets.forEach(target => {
                const card = document.createElement("div");
                card.className = "bg-slate-800/80 p-4 rounded-xl border border-slate-700/80 shadow-md";
                card.innerHTML = `
                    <h4 class="font-bold text-blue-300 text-sm mb-2 flex items-center gap-2">
                        <i class="fa-solid fa-location-dot text-red-400"></i> Knoten: ${target.name}
                    </h4>
                    <div class="grid grid-cols-3 gap-2 text-xs">
                        <div>
                            <label class="block text-slate-400 mb-1">g(n) Strecke</label>
                            <input type="number" id="input-g-${target.id}" class="w-full bg-slate-900 border border-slate-700 rounded-lg p-2 text-white font-mono text-center focus:border-blue-500 focus:outline-none" placeholder="g">
                        </div>
                        <div>
                            <label class="block text-slate-400 mb-1">h(n) Luftlinie</label>
                            <input type="number" id="input-h-${target.id}" class="w-full bg-slate-900 border border-slate-700 rounded-lg p-2 text-white font-mono text-center focus:border-blue-500 focus:outline-none" placeholder="h">
                        </div>
                        <div>
                            <label class="block text-slate-400 mb-1">f(n) = g + h</label>
                            <input type="number" id="input-f-${target.id}" class="w-full bg-slate-900 border border-slate-700 rounded-lg p-2 text-white font-mono text-center focus:border-blue-500 font-bold text-blue-400 focus:outline-none" placeholder="f">
                        </div>
                    </div>
                `;
                container.appendChild(card);
            });

            // Radio / Choice for next expansion node
            if (step.expansionOptions && step.expansionOptions.length > 0) {
                const choiceCard = document.createElement("div");
                choiceCard.className = "bg-slate-800/80 p-4 rounded-xl border border-slate-700/80 shadow-md mt-4";
                
                let optionsHTML = `<h4 class="font-bold text-amber-300 text-sm mb-2">Welcher Knoten wird als Nächstes expandiert?</h4><div class="space-y-2">`;
                step.expansionOptions.forEach((opt, idx) => {
                    optionsHTML += `
                        <label class="flex items-center gap-3 bg-slate-900/60 p-2.5 rounded-lg border border-slate-700/60 cursor-pointer hover:bg-slate-700/50 transition">
                            <input type="radio" name="expansion-choice" value="${opt.id}" class="text-blue-600 focus:ring-blue-500">
                            <span class="text-sm font-medium text-slate-200">${opt.label}</span>
                        </label>
                    `;
                });
                optionsHTML += `</div>`;
                choiceCard.innerHTML = optionsHTML;
                container.appendChild(choiceCard);
            }

            // Trigger MathJax re-render if loaded
            if (window.MathJax) {
                MathJax.typesetPromise();
            }
        }

        function updateSvgHighlights(step) {
            // Reset all nodes
            document.querySelectorAll(".node-circle").forEach(el => {
                el.classList.remove("node-active", "node-expanded");
            });
            document.querySelectorAll(".edge-line").forEach(el => {
                el.classList.remove("edge-active", "edge-path");
            });

            // Highlight expanded nodes
            step.activeNodes.forEach(nodeId => {
                const gElement = document.getElementById(`node-${nodeId}`);
                if (gElement) {
                    const circle = gElement.querySelector("ellipse");
                    if (circle) circle.classList.add("node-expanded");
                }
            });

            // Highlight active edges
            step.activeEdges.forEach(edgeId => {
                const edge = document.getElementById(edgeId);
                if (edge) edge.classList.add("edge-active");
            });
        }

        function checkStep() {
            const step = steps[currentStep - 1];
            let isValid = true;
            let errorMessage = "";

            // Check inputs for target nodes
            for (let target of step.targets) {
                const inputG = parseInt(document.getElementById(`input-g-${target.id}`)?.value);
                const inputH = parseInt(document.getElementById(`input-h-${target.id}`)?.value);
                const inputF = parseInt(document.getElementById(`input-f-${target.id}`)?.value);

                if (isNaN(inputG) || isNaN(inputH) || isNaN(inputF)) {
                    isValid = false;
                    errorMessage = "Bitte fülle alle Eingabefelder aus!";
                    break;
                }

                if (inputG !== target.correctG || inputH !== target.correctH || inputF !== target.correctF) {
                    isValid = false;
                    errorMessage = `Die Berechnungen für ${target.name} sind nicht korrekt. Prüfe g(n), h(n) und f(n) noch einmal!`;
                    break;
                }
            }

            // Check node selection choice if applicable
            if (isValid && step.expansionOptions && step.expansionOptions.length > 0) {
                const selected = document.querySelector('input[name="expansion-choice"]:checked');
                if (!selected) {
                    isValid = false;
                    errorMessage = "Bitte wähle aus, welcher Knoten als Nächstes expandiert werden soll!";
                } else {
                    const correctChoice = step.expansionOptions.find(o => o.correct).id;
                    if (selected.value !== correctChoice) {
                        isValid = false;
                        errorMessage = "Falsche Knotenwahl! Wähle immer den Knoten mit dem *kleinsten* f-Wert.";
                    }
                }
            }

            // Show feedback
            const feedbackEl = document.getElementById("feedback-message");
            feedbackEl.classList.remove("hidden");

            if (isValid) {
                feedbackEl.className = "mb-4 p-3 rounded-lg text-sm font-medium bg-emerald-500/20 text-emerald-300 border border-emerald-500/40";
                
                if (currentStep < steps.length) {
                    feedbackEl.innerHTML = `<i class="fa-solid fa-circle-check mr-2"></i> <strong>Richtig!</strong> Alle Werte sind korrekt berechnet. Klicke auf 'Weiter'.`;
                    document.getElementById("btn-check").classList.add("hidden");
                    document.getElementById("btn-next").classList.remove("hidden");
                } else {
                    feedbackEl.innerHTML = `<i class="fa-solid fa-trophy text-amber-400 mr-2"></i> <strong>Hervorragend!</strong> Du hast den optimalen Pfad gefunden: <br><span class="font-mono text-emerald-200 mt-1 inline-block">Saarbrücken &rarr; Kaiserslautern &rarr; Ludwigshafen &rarr; Würzburg</span> mit Gesamtkosten von <strong>243 km</strong>!`;
                    document.getElementById("btn-check").classList.add("hidden");
                    
                    // Final SVG path highlight
                    document.getElementById("edge-SB-KL").classList.add("edge-path");
                    document.getElementById("edge-KL-LU").classList.add("edge-path");
                    document.getElementById("edge-LU-WUE").classList.add("edge-path");
                }
            } else {
                feedbackEl.className = "mb-4 p-3 rounded-lg text-sm font-medium bg-rose-500/20 text-rose-300 border border-rose-500/40";
                feedbackEl.innerHTML = `<i class="fa-solid fa-triangle-exclamation mr-2"></i> ${errorMessage}`;
            }
        }

        function nextStep() {
            if (currentStep < steps.length) {
                currentStep++;
                renderStep();
            }
        }

        function resetTask() {
            currentStep = 1;
            renderStep();
        }

        function toggleHelpModal() {
            const modal = document.getElementById("help-modal");
            modal.classList.toggle("hidden");
        }
    </script>
</body>
</html>
